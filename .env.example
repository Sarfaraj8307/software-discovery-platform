# Software Discovery Platform — environment configuration
#
# Copy this file to .env.local (development) and fill in real values.
# Production values are injected by the deploy platform; do NOT commit them.
#
# -----------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------

# Public URL of the deployed site. Used as metadataBase, canonical URL,
# OG image URL, and sitemap host. Replace before the first production build.
NEXT_PUBLIC_SITE_URL=https://software-discovery.example

# -----------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------
#
# The browser only ever sees SUPABASE_URL and SUPABASE_ANON_KEY.
# SUPABASE_SERVICE_ROLE_KEY is server-only and MUST NEVER be exposed in
# browser code — it bypasses Row Level Security.
#
# Until these are filled in, the app falls back to its deterministic
# in-process dataset (lib/data/seed.ts). The moment they are present, every
# repository accessor should switch to Supabase — see the planned migration
# in lib/data/repository.ts.
#
# Get these from your Supabase project: Project Settings -> API.

# Public — safe to ship to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Read only by server-side route handlers,
# server components, and the Supabase migration runner. Never import
# @supabase/supabase-js with this key into a "use client" module.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Used by migration tooling only.
# Optional — Supabase's API is sufficient for the app itself.
DATABASE_URL=

# -----------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------
#
# Public bucket name (for product_media, vendor_assets, hero, banners).
# Reads are anonymous; writes go through signed upload URLs minted by
# server-side route handlers.
SUPABASE_STORAGE_BUCKET=media

# Private bucket name (for any non-public assets). Read requires a
# signed URL minted by the server.
SUPABASE_STORAGE_PRIVATE_BUCKET=private

# -----------------------------------------------------------------------
# Rate limiting (Phase 35 — in-memory today, Redis later)
# -----------------------------------------------------------------------

# Sliding window for /api/leads, in milliseconds. 60_000 = 60 s.
LEAD_RATE_LIMIT_WINDOW_MS=60000
# Maximum leads per IP per window.
LEAD_RATE_LIMIT_MAX=5